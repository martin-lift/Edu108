            {
              "id": "answer-3",
              "text": "Различният размер на задачите няма значение за процента работа."
            },
            {
              "id": "answer-4",
              "text": "На ден 3 се проверява дали текстовете действително са приети."
            },
            {
              "id": "answer-5",
              "text": "Миналият планиран край прави резултата приет автоматично."
            },
            {
              "id": "answer-6",
              "text": "Липсващ час може да е пречка за следващи задачи."
            }
          ],
          "correct_option_ids": [
