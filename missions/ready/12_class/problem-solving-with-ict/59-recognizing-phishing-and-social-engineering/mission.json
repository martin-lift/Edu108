          "instruction_format": "html",
          "options": [
            {
              "id": "answer-1",
              "text": "Социалното инженерство може да използва страх или спешност."
            },
            {
              "id": "answer-2",
              "text": "Добрият правопис гарантира безопасност."
            },
            {
              "id": "answer-3",
              "text": "Познато лого и HTTPS сами не доказват подателя."
            },
            {
              "id": "answer-4",
              "text": "Фишингът се среща само в имейл."
            },
            {
              "id": "answer-5",
              "text": "Проверката използва предварително известен независим канал."
            },
            {
              "id": "answer-6",
              "text": "Телефонът от съмнителното съобщение винаги е независим контакт."
            }
          ],
