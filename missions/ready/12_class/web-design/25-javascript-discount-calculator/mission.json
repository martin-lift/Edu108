      {
        "id": "topic-4",
        "step_content": {
          "type": "information",
          "title": "Проследете JavaScript кода",
          "instruction": "<!doctype html><html lang=\"bg\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><style>\nbody{padding:0;max-width:none}.lesson-demo{max-width:100%}*{box-sizing:border-box}body{margin:0;color:#25243a;background:#fff;font:20px/1.65 \"Segoe UI\",Arial,sans-serif}main{max-width:900px;margin:auto;padding:20px}h3{font-size:23px;line-height:1.3;color:#54316f;margin:24px 0 12px}p{margin:12px 0}li{margin:8px 0}a{color:#553176;overflow-wrap:anywhere}figure{margin:22px 0;padding:12px;background:#f8f5fb;border:1px solid #ded8e8;border-radius:12px}figure img{display:block;max-width:100%;height:auto;margin:auto;max-height:700px;object-fit:contain}figcaption{font-size:16px;color:#54515e;margin-top:10px}.focus,.task,.note{padding:14px 18px;border-left:5px solid #79509b;border-radius:8px;background:#f3edf8}.note{background:#edf6fa;border-color:#387b88}.table-wrap{overflow-x:auto}table{width:100%;border-collapse:collapse;table-layout:fixed;font-size:18px}td,th{padding:10px;border:1px solid #d8cfe1;text-align:left;vertical-align:top;overflow-wrap:anywhere}th{background:#f3edf8}pre{white-space:pre-wrap;overflow-wrap:anywhere;font:17px/1.6 Consolas,monospace;background:#f4f1f7;border-radius:8px;padding:14px}code{overflow-wrap:anywhere}img,svg{max-width:100%;height:auto}details{padding:12px 0;border-bottom:1px solid #ddd}summary{font-weight:600}.mobile-label{display:none}@media(max-width:500px){body{font-size:18px}main{padding:12px}h3{font-size:21px}table,tbody,tr,td,th{display:block;width:100%!important}thead{display:none}tbody tr{border:1px solid #d8cfe1;border-radius:8px;overflow:hidden;margin:12px 0}tbody td,tbody th{border:0;padding:10px 12px}tbody td:first-child{background:#f3edf8;font-weight:600}tbody td+td{border-top:1px solid #e6deed}.mobile-label{display:block;font-weight:600;color:#54316f;margin-bottom:4px}figure{padding:8px}}</style></head><body><main><h3 id=\"javascript\">JavaScript — поведението</h3><pre><code class=\"language-javascript\">const form = document.querySelector(\"#calculator\");\nconst priceInput = document.querySelector(\"#price\");\nconst discountInput = document.querySelector(\"#discount\");\nconst result = document.querySelector(\"#result\");\n\nfunction calculate(event) {\n  event.preventDefault();\n  const price = priceInput.valueAsNumber;\n  const discount = discountInput.valueAsNumber;\n\n  if (!Number.isFinite(price) || price &lt; 0) {\n    result.textContent = \"Въведете валидна цена, която е поне 0.\";\n    priceInput.focus();\n    return;\n  }\n  if (!Number.isFinite(discount) || discount &lt; 0 || discount &gt; 100) {\n    result.textContent = \"Въведете отстъпка между 0 и 100.\";\n    discountInput.focus();\n    return;\n  }\n\n  const saved = price * (discount / 100);\n  const finalPrice = price * (1 - discount / 100);\n  result.textContent = \"Отстъпка: \" + saved.toFixed(2) +\n    \" ед. Крайна цена: \" + finalPrice.toFixed(2) + \" ед.\";\n}\n\nform.addEventListener(\"submit\", calculate);\nform.addEventListener(\"input\", function () {\n  result.textContent = \"Стойностите са променени. Изберете отново „Изчисли“.\";\n});</code></pre><figure><img src=\"https://raw.githubusercontent.com/martin-lift/Edu108/main/missions/ready/12_class/web-design/25-javascript-discount-calculator/images/topic-4.svg\" width=\"760\" height=\"276\" alt=\"Submit прочита двете числа; Грешка → съобщение и край; Валиден вход → формули и резултат\"><figcaption>Проследете JavaScript кода</figcaption></figure></main></body></html>"
